page {
  background: #f7f1e8;
  color: #2c2416;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view, text, navigator, button, input, textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
}

button::after {
  border: none;
}

.safe-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 180rpx;
}

.card {
  background: #fffbf4;
  border-radius: 28rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(163, 59, 43, 0.08);
}

.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #a33b2b;
  color: #fff;
  border-radius: 999rpx;
  font-weight: 600;
  font-size: 30rpx;
}

.btn-ghost {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #efe6d6;
  color: #2c2416;
  border-radius: 999rpx;
  font-weight: 600;
  font-size: 30rpx;
}

.muted {
  color: #8a8174;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.tag-anon {
  background: #e8edf5;
  color: #5b6e8c;
}

.tag-named {
  background: #f4e4df;
  color: #a33b2b;
}

.empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #8a8174;
}
