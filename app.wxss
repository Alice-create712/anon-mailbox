page {
  background: #f7f1e8;
  color: #2c2416;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.lined {
  background-color: #fff8ee;
  background-image: repeating-linear-gradient(
    transparent,
    transparent 47rpx,
    rgba(163, 59, 43, 0.12) 48rpx
  );
  background-size: 100% 48rpx;
}

.q-hand {
  font-family: "KaiTi", "STKaiti", "PingFang SC", serif;
  font-size: 32rpx;
  line-height: 48rpx;
}

.a-print {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  font-weight: 600;
}

.sheet {
  background: #fff8ee;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(163, 59, 43, 0.1);
}

.sheet.tilt {
  transform: rotate(-0.6deg);
}

.sheet.tilt-r {
  transform: rotate(0.7deg);
}

.wax {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #a33b2b;
  color: #fffbf4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 32rpx;
}

.empty-env {
  text-align: center;
  padding: 48rpx 20rpx 32rpx;
}

.env-mini {
  width: 200rpx;
  height: 120rpx;
  margin: 0 auto 16rpx;
  background: #f4e6d0;
  border: 2rpx solid rgba(163, 59, 43, 0.18);
  position: relative;
}

.env-mini::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  border-left: 100rpx solid transparent;
  border-right: 100rpx solid transparent;
  border-top: 56rpx solid #e8d5bc;
}

view, text, navigator, button, input, textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
}

button::after {
  border: none;
}

.safe-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 180rpx;
}

.card {
  background: #fffbf4;
  border-radius: 28rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(163, 59, 43, 0.08);
}

.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #a33b2b;
  color: #fff;
  border-radius: 999rpx;
  font-weight: 600;
  font-size: 30rpx;
}

.btn-ghost {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #efe6d6;
  color: #2c2416;
  border-radius: 999rpx;
  font-weight: 600;
  font-size: 30rpx;
}

.muted {
  color: #8a8174;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.tag-anon {
  background: #e8edf5;
  color: #5b6e8c;
}

.tag-named {
  background: #f4e4df;
  color: #a33b2b;
}

.empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #8a8174;
}
