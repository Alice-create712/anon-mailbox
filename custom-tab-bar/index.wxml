<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="item {{selected === index ? 'on' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <text class="icon">{{item.icon}}</text>
    <text class="text">{{item.text}}</text>
  </view>
</view>
