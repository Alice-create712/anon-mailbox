.card {
  margin-top: 20rpx;
}

.body {
  font-size: 32rpx;
  margin: 20rpx 0 12rpx;
}

.tiny {
  font-size: 22rpx;
}

.reply {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #efe6d6;
}

.area {
  width: 100%;
  height: 200rpx;
  background: #f7f1e8;
  border-radius: 20rpx;
  padding: 20rpx;
}

.vis {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 20rpx 0;
}

.chip {
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f7f1e8;
  font-weight: 600;
  font-size: 26rpx;
}

.chip.on {
  background: #5b6e8c;
  color: #fff;
}

.chip.on.named {
  background: #a33b2b;
}

.btn-ghost {
  margin-top: 20rpx;
}

.row-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.ghost-mini {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #efe6d6;
  border-radius: 999rpx;
}
