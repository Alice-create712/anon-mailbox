.hello {
  margin: 8rpx 8rpx 28rpx;
}

.hi {
  font-size: 44rpx;
  font-weight: 700;
}

.search-title,
.create-title,
.section-title {
  font-weight: 700;
  margin-bottom: 16rpx;
}

.section-title {
  margin: 36rpx 8rpx 16rpx;
}

.search-row {
  display: flex;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  background: #f7f1e8;
  border-radius: 20rpx;
  padding: 0 24rpx;
}

.search-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #a33b2b;
  color: #fff;
  border-radius: 20rpx;
  font-weight: 600;
}

.tiny {
  font-size: 22rpx;
}

.letter,
.create-card,
.search {
  margin-top: 24rpx;
}

.stamp {
  display: inline-block;
  border: 3rpx solid #a33b2b;
  color: #a33b2b;
  font-weight: 800;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.letter-title {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.share-btn,
.letter .btn-ghost {
  margin-top: 20rpx;
  width: 100%;
}

.letter-foot {
  margin-top: 20rpx;
  color: #a33b2b;
  font-weight: 600;
  text-align: center;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.box-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
}

.box-code {
  width: 88rpx;
  color: #a33b2b;
  font-weight: 800;
}

.box-main {
  flex: 1;
}

.box-title {
  font-weight: 600;
}

.go {
  color: #a33b2b;
  font-size: 24rpx;
}
