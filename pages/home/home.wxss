.home {
  padding-top: 16rpx;
}

.hello {
  text-align: center;
  margin-bottom: 12rpx;
}

.hi {
  font-size: 48rpx;
  font-weight: 800;
  color: #a33b2b;
  letter-spacing: 6rpx;
}

.tagline {
  margin-top: 8rpx;
}

.env-wrap {
  margin: 20rpx 8rpx 8rpx;
}

.flap {
  width: 0;
  height: 0;
  margin: 0 auto;
  border-left: 320rpx solid transparent;
  border-right: 320rpx solid transparent;
  border-bottom: 88rpx solid #e8d5bc;
}

.env-body {
  position: relative;
  background: #f4e6d0;
  border: 2rpx solid rgba(163, 59, 43, 0.12);
  padding: 80rpx 36rpx 40rpx;
  text-align: center;
  min-height: 420rpx;
}

.wax {
  position: absolute;
  left: 50%;
  top: -44rpx;
  transform: translateX(-50%);
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #a33b2b;
  color: #fffbf4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 32rpx;
}

.wax.pulse {
  background: #5b6e8c;
}

.stamp {
  display: inline-block;
  border: 3rpx solid #a33b2b;
  color: #a33b2b;
  font-weight: 800;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.env-title {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.share-btn {
  margin-top: 28rpx;
}

.env-actions {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 24rpx;
  color: #a33b2b;
  font-weight: 600;
  font-size: 26rpx;
}

.floor {
  margin-top: 8rpx;
  padding-bottom: 12rpx;
}

.floor-title {
  font-size: 24rpx;
  color: #8a8174;
  margin: 8rpx 8rpx 16rpx;
}

.slips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.slip {
  flex: 1 1 44%;
  background: #fff8ee;
  border: 2rpx dashed #c4a574;
  padding: 18rpx 16rpx;
  font-size: 22rpx;
  color: #5b6e8c;
  min-height: 88rpx;
}

.find-strip {
  padding: 20rpx 20rpx 24rpx;
  border: 1rpx solid rgba(163, 59, 43, 0.1);
}

.find-label {
  font-size: 22rpx;
  color: #8a8174;
  margin-bottom: 12rpx;
}

.search-row {
  display: flex;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  background: #fffbf4;
  border-radius: 20rpx;
  padding: 0 24rpx;
}

.search-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #a33b2b;
  color: #fff;
  border-radius: 20rpx;
  font-weight: 600;
}

.tiny {
  font-size: 22rpx;
}

.topic-line {
  margin: 8rpx 12rpx 4rpx;
  color: #5b6e8c;
  font-size: 24rpx;
}

.notify-line {
  margin-top: 16rpx;
  color: #8a8174;
  font-size: 22rpx;
  text-decoration: underline;
}

.recent {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding: 0 4rpx 16rpx;
}

.recent-item {
  min-width: 200rpx;
  background: #fff8ee;
  border: 1rpx solid rgba(163, 59, 43, 0.1);
  padding: 16rpx;
}

.recent-title {
  font-size: 24rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.mini-stamp {
  font-size: 20rpx;
  padding: 2rpx 8rpx;
}
