<view class="safe-page">
  <view class="pause-bar" wx:if="{{mailboxCode}}" bindtap="togglePause">
    {{paused ? '信箱已暂停 · 点此重新打开' : '接收中 · 点此暂停来信'}}
  </view>
  <view class="tabs">
    <view class="tab {{tab === 'unanswered' ? 'on' : ''}}" data-tab="unanswered" bindtap="setTab">未答 {{unreadCount ? unreadCount : ''}}</view>
    <view class="tab {{tab === 'later' ? 'on' : ''}}" data-tab="later" bindtap="setTab">稍后 {{later.length ? later.length : ''}}</view>
    <view class="tab {{tab === 'answered' ? 'on' : ''}}" data-tab="answered" bindtap="setTab">已答</view>
    <view class="tab {{tab === 'sent' ? 'on' : ''}}" data-tab="sent" bindtap="setTab">发出</view>
  </view>

  <block wx:if="{{tab === 'unanswered'}}">
    <view class="empty" wx:if="{{!mailboxCode}}">
      <view>你还没有发布信箱</view>
      <view class="btn-primary mini" bindtap="goCreate">去发布</view>
    </view>
    <view class="empty-env" wx:elif="{{!unanswered.length}}">
      <view class="env-mini"></view>
      <view>没有待拆的来信</view>
    </view>
    <view class="card item" wx:for="{{unanswered}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
      <view class="row">
        <view class="tag {{item.isAnonymous ? 'tag-anon' : 'tag-named'}}">{{item.isAnonymous ? '匿名来信' : '署名来信'}}</view>
        <view class="status">{{item.read ? '已读 · 待回复' : '未读'}}</view>
      </view>
      <view class="content">{{item.content}}</view>
      <view class="muted tiny">{{item.timeText}}</view>
    </view>
  </block>

  <block wx:elif="{{tab === 'later'}}">
    <view class="empty-env" wx:if="{{!later.length}}">
      <view class="env-mini"></view>
      <view>没有稍后要回的信</view>
    </view>
    <view class="card item" wx:for="{{later}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
      <view class="row">
        <view class="tag {{item.isAnonymous ? 'tag-anon' : 'tag-named'}}">{{item.isAnonymous ? '匿名来信' : '署名来信'}}</view>
        <view class="status">稍后回</view>
      </view>
      <view class="content">{{item.content}}</view>
      <view class="muted tiny">{{item.timeText}}</view>
    </view>
  </block>

  <block wx:elif="{{tab === 'answered'}}">
    <view class="empty" wx:if="{{!received.length}}">还没有回复过</view>
    <view class="card item" wx:for="{{received}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
      <view class="row">
        <view class="tag {{item.isAnonymous ? 'tag-anon' : 'tag-named'}}">{{item.isAnonymous ? '匿名来信' : '署名来信'}}</view>
        <view class="status done">{{item.reply.visibility === 'private' ? '仅对方可见' : (item.reply.visibility === 'everyone' ? '已公开' : '信箱墙')}}</view>
      </view>
      <view class="content">{{item.content}}</view>
      <view class="reply">{{item.reply.content}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="empty" wx:if="{{!sent.length}}">你还没有给别人留过言</view>
    <view class="card item" wx:for="{{sent}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
      <view class="row">
        <view class="to">发给 #{{item.mailboxCode}} {{item.mailbox.title}}</view>
        <view class="status {{item.reply ? 'done' : ''}}">{{item.statusText}}</view>
      </view>
      <view class="content">{{item.content}}</view>
      <view class="muted tiny">{{item.isAnonymous ? '你以匿名发送' : '你以署名发送'}} · {{item.timeText}}</view>
      <view class="reply" wx:if="{{item.reply}}">{{item.reply.content}}</view>
    </view>
  </block>
</view>
