.login {
  min-height: 100vh;
  padding: 160rpx 48rpx 80rpx;
  background: #f7f1e8;
}

.hero {
  margin-bottom: 56rpx;
}

.seal {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #a33b2b;
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.sub {
  margin-top: 12rpx;
  color: #8a8174;
  font-size: 28rpx;
}

.form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  border-radius: 70rpx;
  overflow: hidden;
  background: #efe6d6;
}

.avatar,
.placeholder {
  width: 140rpx;
  height: 140rpx;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8174;
}

.nick {
  width: 100%;
  height: 88rpx;
  background: #f7f1e8;
  border-radius: 20rpx;
  padding: 0 28rpx;
}

.hint {
  color: #8a8174;
  font-size: 24rpx;
  text-align: center;
}

.agree {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 36rpx 8rpx 28rpx;
}

.check {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #c4b8a4;
  border-radius: 8rpx;
  margin-top: 4rpx;
}

.check.on {
  background: #a33b2b;
  border-color: #a33b2b;
}

.agree-text {
  flex: 1;
  color: #8a8174;
  font-size: 24rpx;
}

.link {
  color: #a33b2b;
}

.enter {
  width: 100%;
}
