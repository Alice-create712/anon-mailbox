<view class="safe-page" wx:if="{{mailbox}}">
  <view class="hero">
    <view class="wax">匿</view>
    <view class="stamp">邮戳 #{{mailbox.code}}</view>
    <view class="title">{{mailbox.title}}</view>
    <view class="welcome">{{mailbox.intro}}</view>
    <view class="topic" wx:if="{{mailbox.topic}}">本周想被问 · {{mailbox.topic}}</view>
    <button class="ghost-link" open-type="share">把这只信封发给朋友</button>
  </view>

  <block wx:if="{{!isOwner}}">
    <view class="paused" wx:if="{{mailbox.paused}}">这只信箱暂时封口了。</view>
    <block wx:else>
      <view class="topic-card lined" wx:if="{{mailbox.topic}}" bindtap="useTopic">{{mailbox.topic}}</view>
      <view class="slips">
        <view class="slip" wx:for="{{slips}}" wx:key="*this" data-text="{{item}}" bindtap="pickSlip">{{item}}</view>
      </view>
      <view class="write lined">
        <view class="mode">
          <view class="mode-item {{isAnonymous ? 'on' : ''}}" bindtap="setAnon">匿名</view>
          <view class="mode-item {{!isAnonymous ? 'on named' : ''}}" bindtap="setNamed">署名</view>
        </view>
        <textarea
          class="area"
          maxlength="500"
          placeholder="在信纸上写下你不敢公开说的话"
          value="{{content}}"
          bindinput="onContent"
        />
        <view class="btn-primary" bindtap="send">{{isAnonymous ? '匿名封进信封' : '署名封进信封'}}</view>
      </view>
    </block>
  </block>

  <view class="owner-bar" wx:else>
    <text>来信在「来信」里回复。下面是已经贴上墙的纸。</text>
    <text class="link" bindtap="toggleSettings">{{showSettings ? '收起整理' : '整理信箱'}}</text>
  </view>
  <view class="settings" wx:if="{{isOwner && showSettings}}">
    <view class="btn-ghost" bindtap="togglePause">{{mailbox.paused ? '重新打开' : '暂停接收'}}</view>
    <view class="mute-row">
      <input class="mute-input" placeholder="本周想被问的一句" value="{{topicInput}}" bindinput="onTopic" maxlength="40" />
      <view class="mute-add" bindtap="saveTopic">贴上</view>
    </view>
    <view class="mute-row">
      <input class="mute-input" placeholder="屏蔽词" value="{{muteInput}}" bindinput="onMute" />
      <view class="mute-add" bindtap="addMute">添加</view>
    </view>
  </view>

  <view class="wall-title">贴在墙上的问答</view>
  <view class="empty-env" wx:if="{{!messages.length}}">
    <view class="env-mini"></view>
    <view>信封还是空的</view>
  </view>
  <view
    class="sheet {{index % 2 ? 'tilt-r' : 'tilt'}}"
    wx:for="{{messages}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="openThread"
  >
    <view class="tag {{item.isAnonymous ? 'tag-anon' : 'tag-named'}}">{{item.isAnonymous ? '匿名来信' : '署名来信'}}</view>
    <view class="q-hand lined q">{{item.content}}</view>
    <view class="a-print" wx:if="{{item.reply}}">{{item.reply.content}}</view>
  </view>
</view>
