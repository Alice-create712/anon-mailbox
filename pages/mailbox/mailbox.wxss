.hero {
  text-align: center;
  padding: 12rpx 8rpx 28rpx;
}

.hero .wax {
  margin: 0 auto 16rpx;
}

.stamp {
  display: inline-block;
  border: 3rpx solid #a33b2b;
  color: #a33b2b;
  font-weight: 800;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  letter-spacing: 2rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  margin: 16rpx 0 8rpx;
}

.welcome {
  font-size: 30rpx;
  line-height: 1.6;
}

.topic {
  margin-top: 12rpx;
  color: #5b6e8c;
  font-size: 24rpx;
}

.ghost-link {
  margin-top: 16rpx;
  color: #a33b2b;
  font-weight: 600;
  font-size: 26rpx;
}

.slips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.slip {
  max-width: 48%;
  flex: 1 1 44%;
  background: #fff8ee;
  border: 2rpx dashed #c4a574;
  padding: 16rpx 18rpx;
  font-size: 22rpx;
  color: #5b6e8c;
}

.write {
  padding: 24rpx 20rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(163, 59, 43, 0.1);
}

.mode {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.mode-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: rgba(255, 251, 244, 0.7);
  font-weight: 600;
}

.mode-item.on {
  background: #5b6e8c;
  color: #fff;
}

.mode-item.on.named {
  background: #a33b2b;
}

.area {
  width: 100%;
  height: 240rpx;
  background: transparent;
  margin-bottom: 20rpx;
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 30rpx;
  line-height: 48rpx;
}

.paused {
  text-align: center;
  color: #a33b2b;
  font-weight: 600;
  padding: 40rpx 0;
}

.owner-bar {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: #8a8174;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.link {
  color: #a33b2b;
  font-weight: 600;
}

.settings {
  margin-bottom: 24rpx;
}

.mute-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mute-input {
  flex: 1;
  height: 72rpx;
  background: #fffbf4;
  padding: 0 20rpx;
}

.mute-add {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #a33b2b;
  color: #fff;
}

.wall-title {
  font-weight: 700;
  margin: 12rpx 4rpx 16rpx;
}

.q {
  margin: 16rpx 0;
  min-height: 96rpx;
  padding-top: 8rpx;
}

.a-print {
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(163, 59, 43, 0.12);
}
