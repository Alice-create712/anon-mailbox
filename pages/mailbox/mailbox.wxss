.stamp {
  display: inline-block;
  border: 3rpx solid #a33b2b;
  color: #a33b2b;
  font-weight: 800;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.header .title {
  font-size: 36rpx;
  font-weight: 700;
  margin: 8rpx 0 12rpx;
}

.share-btn,
.follow,
.owner-tip .btn-ghost {
  margin-top: 20rpx;
  width: 100%;
}

.composer,
.owner-tip {
  margin-top: 20rpx;
}

.mode {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.mode-item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #f7f1e8;
  font-weight: 600;
}

.mode-item.on {
  background: #5b6e8c;
  color: #fff;
}

.mode-item.on.named {
  background: #a33b2b;
}

.tiny {
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.prompt {
  background: #f7f1e8;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
  color: #5b6e8c;
}

.area {
  width: 100%;
  height: 200rpx;
  background: #f7f1e8;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.mute-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mute-input {
  flex: 1;
  height: 72rpx;
  background: #f7f1e8;
  border-radius: 16rpx;
  padding: 0 20rpx;
}

.mute-add {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #a33b2b;
  color: #fff;
  border-radius: 16rpx;
}

.paused {
  color: #a33b2b;
  font-weight: 600;
}

.section-title {
  margin: 36rpx 8rpx 16rpx;
  font-weight: 700;
}

.msg {
  margin-bottom: 16rpx;
}

.msg-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.q {
  font-size: 30rpx;
}

.reply {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #efe6d6;
}
